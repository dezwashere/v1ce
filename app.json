{
  "expo": {
    "name": "V1CE",
    "slug": "v1ce",
    "owner": "stickycat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "v1ce",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.v1ce",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.v1ce"
        ]
      },
      "appleTeamId": "4UPD3DH3FP"
    },
    "android": {
      "package": "app.v1ce",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F7F7F7"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      [
        "expo-router",
        {
          "origin": "https://v1ce.app"
        }
      ],
      "expo-font",
      "expo-calendar",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "backgroundColor": "#F7F7F7",
          "imageWidth": 200
        }
      ],
      [
        "@bacons/apple-targets"
      ],
      "./plugins/withV1CEWidgetFonts.js",
      "./plugins/withV1CECoinRuntimeAssets.js",
      "./plugins/app.plugin.js"
    ],
    "extra": {
      "eas": {
        "projectId": "7da6caaf-6da0-45af-a389-3eac8719c6f8"
      },
      "v1ceSourceLabel": "internal candidate | 2026-10-15 | coin/widget UI and build diagnostics | source 0fb8d65022ab63df3ccc37483546291184269418 + working tree"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/7da6caaf-6da0-45af-a389-3eac8719c6f8"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
